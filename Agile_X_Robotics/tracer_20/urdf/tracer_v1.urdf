<?xml version="1.0"?>
<!-- Merged from tracer_v1.xacro and all included xacro files -->
<robot name="tracer_v1">

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://Agile_X_Robotics/tracer_20/meshes/tracer_base_link.stl" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://Agile_X_Robotics/tracer_20/meshes/tracer_base_link.stl" />
      </geometry>
