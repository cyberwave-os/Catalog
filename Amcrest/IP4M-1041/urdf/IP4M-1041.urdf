<?xml version="1.0"?>
<robot name="amcrest_ip4m_1041b">
  <!-- REP-103: +X lens-forward, +Y left, +Z up. Mesh units are metres. -->
  <material name="black_plastic">
    <color rgba="0.012 0.014 0.018 1.0"/>
  </material>

  <link name="amcrest_base_link">
    <visual>
      <geometry>
        <mesh filename="../meshes/IP4M_1041_base_visual.obj"/>
      </geometry>
      <material name="black_plastic"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="../meshes/IP4M_1041_base_collision.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.017" rpy="0 0 0"/>
      <mass value="0.120"/>
      <inertia ixx="0.000118" ixy="0" ixz="0"
               iyy="0.000112" iyz="0" izz="0.000206"/>
    </inertial>
  </link>

  <link name="amcrest_pan_link">
    <visual>
      <geometry>
        <mesh filename="../meshes/IP4M_1041_pan_visual.obj"/>
      </geometry>
      <material name="black_plastic"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="../meshes/IP4M_1041_pan_collision.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.041" rpy="0 0 0"/>
      <mass value="0.100"/>
      <inertia ixx="0.000128" ixy="0" ixz="0"
               iyy="0.000125" iyz="0" izz="0.000135"/>
    </inertial>
  </link>

  <!-- Horizontal actuator: full rotation around the vertical axis. -->
  <joint name="amcrest_pan_joint" type="continuous">
    <origin xyz="0 0 0.036" rpy="0 0 0"/>
    <parent link="amcrest_base_link"/>
    <child link="amcrest_pan_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.0" velocity="2.5"/>
    <dynamics damping="0.08" friction="0.02"/>
  </joint>

  <link name="amcrest_tilt_link">
    <visual>
      <geometry>
        <mesh filename="../meshes/IP4M_1041_tilt_visual.obj"/>
      </geometry>
      <material name="black_plastic"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="../meshes/IP4M_1041_tilt_collision.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.070"/>
      <inertia ixx="0.000058" ixy="0" ixz="0"
               iyy="0.000064" iyz="0" izz="0.000055"/>
    </inertial>
  </link>

  <!-- Vertical actuator: camera-head pitch around its modeled center. -->
  <joint name="amcrest_tilt_joint" type="revolute">
    <origin xyz="-0.000281259 0.001454012 0.044" rpy="0 0 0"/>
    <parent link="amcrest_pan_link"/>
    <child link="amcrest_tilt_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57079632679" upper="0.78539816339"
           effort="1.0" velocity="2.0"/>
    <dynamics damping="0.08" friction="0.02"/>
  </joint>

  <link name="amcrest_camera_frame"/>
  <joint name="amcrest_camera_frame_joint" type="fixed">
    <origin xyz="0.035 0 0" rpy="0 0 0"/>
    <parent link="amcrest_tilt_link"/>
    <child link="amcrest_camera_frame"/>
  </joint>

  <link name="amcrest_camera_optical_frame"/>
  <joint name="amcrest_camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    <parent link="amcrest_camera_frame"/>
    <child link="amcrest_camera_optical_frame"/>
  </joint>
</robot>
