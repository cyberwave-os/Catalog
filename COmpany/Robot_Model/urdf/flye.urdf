<?xml version="1.0"?>
<robot name="flye">
  
  <!-- Base link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://Robot_Model/meshes/flye.stl" scale="1 1 1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://Robot_Model/meshes/flye.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    
    <!-- Inertial properties (placeholder - adjust based on actual mass/inertia) -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" 
               iyy="0.01" iyz="0.0" 
               izz="0.01"/>
    </inertial>
  </link>
  
</robot>
