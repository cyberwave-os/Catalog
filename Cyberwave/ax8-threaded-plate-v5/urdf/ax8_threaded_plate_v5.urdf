<?xml version="1.0"?>
<!--
  FLIR AX8 threaded mounting plate, v5.0 (1/4-20 thread, air sacs). Mass is the sliced PLA estimate (11.7 g).
  Mesh is authored in millimetres (the print file itself); scale 0.001 converts to metres.
  Print files for the printer twin's "Print +" picker are listed in the asset metadata
  (print_files) and live under ../print/.
-->
<robot name="ax8_threaded_plate_v5">
  <link name="ax8_threaded_plate_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/ax8_threaded_plate.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="pla_grey"><color rgba="0.85 0.85 0.8 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/ax8_threaded_plate.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.00868" rpy="0 0 0"/>
      <mass value="0.0117"/>
      <inertia ixx="9.279e-06" ixy="0" ixz="0" iyy="2.731e-06" iyz="0" izz="1.142e-05"/>
    </inertial>
  </link>
</robot>
