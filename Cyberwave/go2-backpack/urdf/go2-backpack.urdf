    <visual name="logo_corpo245_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/case-logo/Corpo245.stl" scale="0.00102348 0.00102348 0.00102348"/>
      </geometry>
      <material name="logo_light"/>
    </visual>

    <visual name="logo_corpo246_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
