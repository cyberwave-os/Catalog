      </geometry>
      <material name="logo_light"/>
    </visual>

    <visual name="logo_corpo249_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/case-logo/Corpo249.stl" scale="0.00102348 0.00102348 0.00102348"/>
      </geometry>
      <material name="logo_light"/>
    </visual>

    <visual name="logo_corpo250_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/case-logo/Corpo250.stl" scale="0.00102348 0.00102348 0.00102348"/>
      </geometry>
      <material name="logo_light"/>
    </visual>

    <!-- Simplified collision set -->
    <collision name="layer1_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/layer1.stl" scale="0.00102348 0.00102348 0.00102348"/>
      </geometry>
    </collision>

    <collision name="layer2_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/layer2.stl" scale="0.00102348 0.00102348 0.00102348"/>
      </geometry>
    </collision>

    <collision name="layer3_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/layer3.stl" scale="0.00102348 0.00102348 0.00102348"/>
      </geometry>
    </collision>

    <collision name="power_base_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/power-base.stl" scale="0.00102348 0.00102348 0.00102348"/>
      </geometry>
    </collision>
  </link>
</robot>