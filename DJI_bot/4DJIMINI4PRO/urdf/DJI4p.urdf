<?xml version="1.0"?>
<robot name="dji_mini_4_pro">

  <material name="drone_grey">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <material name="prop_dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://4DJIMINI4PRO/meshes/body.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="drone_grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://4DJIMINI4PRO/meshes/body.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.245"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <link name="prop_front_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://4DJIMINI4PRO/meshes/prop_front_left.stl" scale="0.01 0.01 0.01"/>
