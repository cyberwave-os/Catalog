<?xml version="1.0"?>
<robot name="dji_mini_3_pro">

  <link name="base_link">
  
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/mini3pro.stl" scale="1.0 1.0 1.0" />
      </geometry>
      <material name="drone_grey">
        <color rgba="0.7 0.7 0.7 1.0" />
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/mini3pro.stl" scale="1.0 1.0 1.0" />
      </geometry>
    </collision>

    <inertial>
      <mass value="0.249" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
    
  </link>

</robot>

