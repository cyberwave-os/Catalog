<robot name="sentinel_drone">

  <material name="fallback_dark">
    <color rgba="0.15 0.15 0.17 1" />
  </material>

  <!-- ==================== Body ==================== -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/body.stl" scale="0.015 0.015 0.015" />
      </geometry>
    </visual>
    <inertial>
      <mass value="0.92" />
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.005" />
    </inertial>
    <collision>
      <geometry>
        <box size="0.35 0.28 0.11" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== Sensors ==================== -->

  <link name="camera_link">
    <inertial>
      <mass value="0.001" />
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7" />
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin xyz="0 0.1585 0.0091" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="camera_link" />
  </joint>

  <link name="payload_link">
    <inertial>
      <mass value="0.001" />
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7" />
    </inertial>
  </link>
  <joint name="payload_joint" type="fixed">
    <origin xyz="0 0.1585 -0.0209" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="payload_link" />
  </joint>

  <!-- ==================== Propellers ==================== -->

  <link name="prop_fl">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/prop_fl.stl" scale="0.015 0.015 0.015" />
      </geometry>
    </visual>
    <inertial>
      <mass value="0.005" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>
  <joint name="prop_fl_joint" type="continuous">
    <origin xyz="-0.2414 0.1474 0.016" />
    <parent link="base_link" />
    <child link="prop_fl" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="prop_fr">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/prop_fr.stl" scale="0.015 0.015 0.015" />
      </geometry>
    </visual>
    <inertial>
      <mass value="0.005" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>
  <joint name="prop_fr_joint" type="continuous">
    <origin xyz="0.2414 0.1474 0.0162" />
    <parent link="base_link" />
    <child link="prop_fr" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="prop_rl">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/prop_rl.stl" scale="0.015 0.015 0.015" />
      </geometry>
    </visual>
    <inertial>
      <mass value="0.005" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>
  <joint name="prop_rl_joint" type="continuous">
    <origin xyz="-0.1912 -0.2162 0.0057" />
    <parent link="base_link" />
    <child link="prop_rl" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="prop_rr">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/prop_rr.stl" scale="0.015 0.015 0.015" />
      </geometry>
    </visual>
    <inertial>
      <mass value="0.005" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>
  <joint name="prop_rr_joint" type="continuous">
    <origin xyz="0.1912 -0.2162 0.0058" />
    <parent link="base_link" />
    <child link="prop_rr" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- ==================== Arms (structural) ==================== -->

  <link name="arm_fl">
    <inertial><mass value="0.001" /><inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7" /></inertial>
  </link>
  <joint name="arm_fl_joint" type="fixed">
    <origin xyz="-0.1207 0.0737 0.008" />
    <parent link="base_link" />
    <child link="arm_fl" />
  </joint>

  <link name="arm_fr">
    <inertial><mass value="0.001" /><inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7" /></inertial>
  </link>
  <joint name="arm_fr_joint" type="fixed">
    <origin xyz="0.1207 0.0737 0.0081" />
    <parent link="base_link" />
    <child link="arm_fr" />
  </joint>

  <link name="arm_rl">
    <inertial><mass value="0.001" /><inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7" /></inertial>
  </link>
  <joint name="arm_rl_joint" type="fixed">
    <origin xyz="-0.0956 -0.1081 0.0029" />
    <parent link="base_link" />
    <child link="arm_rl" />
  </joint>

  <link name="arm_rr">
    <inertial><mass value="0.001" /><inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7" /></inertial>
  </link>
  <joint name="arm_rr_joint" type="fixed">
    <origin xyz="0.0956 -0.1081 0.0029" />
    <parent link="base_link" />
    <child link="arm_rr" />
  </joint>

</robot>
