<?xml version="1.0"?>
<robot name="warehouse">

  <link name="warehouse_base_link">
  
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://GenericWarehouse/meshes/Warehouse.stl" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="warehouse_gray">
        <color rgba="0.45 0.45 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://GenericWarehouse/meshes/Warehouse.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="10000.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="5000.0" ixy="0.0" ixz="0.0"
        iyy="5000.0" iyz="0.0"
        izz="5000.0"/>
    </inertial>
    
  </link>

</robot>
