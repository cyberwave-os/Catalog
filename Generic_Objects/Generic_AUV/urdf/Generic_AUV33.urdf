<robot name="generic_auv">

  <link name="auv_link">
  
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="/../../meshes/Generic__AUV33.stl" scale="1.0 1.0 1.0" />
      </geometry>
      <material name="auv_blue">
        <color rgba="0.8 0.8 0.8 1.0" />
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="/../../meshes/Generic__AUV33.stl" scale="1.0 1.0 1.0" />
      </geometry>
    </collision>

    <inertial>
      <mass value="10.0" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
    </inertial>
    
  </link>

</robot>