<?xml version="1.0"?>
<robot name="px4_vision">

  <link name="base_link">
  
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://PX4 Vision/meshes/px4Lidl.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="drone_grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://PX4 Vision/meshes/px4Lidl.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.765"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="0.002" ixy="0.0" ixz="0.0"
        iyy="0.002" iyz="0.0"
        izz="0.003"/>
    </inertial>
    
  </link>

</robot>

