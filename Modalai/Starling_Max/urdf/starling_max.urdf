<?xml version="1.0"?>
<robot name="starling_max">

  <material name="drone_grey">
    <color rgba="0.35 0.35 0.38 1.0" />
  </material>

  <!-- ==================== Body ==================== -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/body.stl" scale="1.0 1.0 1.0" />
      </geometry>
      <material name="drone_grey" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.1215 0.0942 0.0546" />
      </geometry>
    </collision>
    <inertial>
      <mass value="3.5" />
      <inertia ixx="0.39" ixy="0" ixz="0" iyy="0.58" iyz="0" izz="0.78" />
    </inertial>
  </link>

  <!-- ==================== Propellers ==================== -->

  <link name="prop_fl">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/prop_fl.stl" scale="1.0 1.0 1.0" />
      </geometry>
      <material name="drone_grey" />
    </visual>
    <inertial>
      <mass value="0.06" />
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.006" />
    </inertial>
  </link>
  <joint name="prop_fl_joint" type="continuous">
    <origin xyz="0.0565 0.0429 0.016" />
    <parent link="base_link" />
    <child link="prop_fl" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="prop_fr">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/prop_fr.stl" scale="1.0 1.0 1.0" />
      </geometry>
      <material name="drone_grey" />
    </visual>
    <inertial>
      <mass value="0.06" />
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.006" />
    </inertial>
  </link>
  <joint name="prop_fr_joint" type="continuous">
    <origin xyz="0.0566 -0.0434 0.0151" />
    <parent link="base_link" />
    <child link="prop_fr" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="prop_rl">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/prop_rl.stl" scale="1.0 1.0 1.0" />
      </geometry>
      <material name="drone_grey" />
    </visual>
    <inertial>
      <mass value="0.06" />
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.006" />
    </inertial>
  </link>
  <joint name="prop_rl_joint" type="continuous">
    <origin xyz="-0.057 0.0426 0.0117" />
    <parent link="base_link" />
    <child link="prop_rl" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="prop_rr">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/prop_rr.stl" scale="1.0 1.0 1.0" />
      </geometry>
      <material name="drone_grey" />
    </visual>
    <inertial>
      <mass value="0.06" />
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.006" />
    </inertial>
  </link>
  <joint name="prop_rr_joint" type="continuous">
    <origin xyz="-0.0558 -0.0429 0.0088" />
    <parent link="base_link" />
    <child link="prop_rr" />
    <axis xyz="0 0 1" />
  </joint>

</robot>
