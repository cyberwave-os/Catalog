<?xml version="1.0" encoding="utf-8"?>
<robot name="unitree_lidar_l2">

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://Lidar_L2/meshes/UnitreeLidarL2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.022" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.044"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.022" rpy="0 0 0"/>
      <mass value="0.195"/>
      <inertia
        ixx="5.0e-05" ixy="0.0" ixz="0.0"
        iyy="5.0e-05" iyz="0.0"
        izz="3.6e-05"/>
    </inertial>
  </link>

  <!-- Laser scanning frame (Z up, X forward) -->
  <link name="lidar_laser_frame"/>

  <joint name="lidar_laser_joint" type="fixed">
    <origin xyz="0 0 0.044" rpy="0 0 0"/>
    <parent link="lidar_link"/>
    <child link="lidar_laser_frame"/>
  </joint>

</robot>
