<robot name="universal-robot-ur5">
  <material name="UR/Blue">
    <color rgba="0.0 0.0 0.8 1.0" />
  </material>
  <material name="UR/Grey">
    <color rgba="0.7 0.7 0.7 1.0" />
  </material>
 


  
  <link name="world" />
  <joint name="world_base_joint" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.01" />
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://UniversalRobots_/UUR5e/meshes/visual/base.dae" />
      </geometry>
      <origin rpy="0.0 0.0 2.3561944875" xyz="0.0 0.0 0.0" />
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://UniversalRobots_/UUR5e/meshes/collision/base.stl" />
      </geometry>
      
    </collision>
    <inertial>
      <mass value="4.0" />
      <inertia ixx="0.004433" ixy="0.0" ixz="0.0" iyy="0.00443333156" iyz="0.0" izz="0.0072" />
    </inertial>
  </link> 

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link" />
    <child link="shoulder_link" />
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.089159" />
    <axis xyz="0 0 1" />
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.14159265" />
    <dynamics damping="0.0" friction="0.0" />
  </joint>
  <link name="shoulder_link">
