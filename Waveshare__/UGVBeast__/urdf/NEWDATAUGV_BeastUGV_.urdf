<?xml version="1.0"?>
<robot name="ugv_beast_pt">

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/ugv_body.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="ugv_grey"><color rgba="0.5 0.5 0.5 1.0" /></material>
    </visual>
    <collision>
      <geometry><mesh filename="../meshes/ugv_body.stl" scale="0.001 0.001 0.001" /></geometry>
    </collision>
    <inertial>
      <mass value="2.5" />
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01" />
    </inertial>
  </link>

  <joint name="left_up_wheel_link_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin xyz="0.15 0.1 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="left_down_wheel_link_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_rear_wheel"/>
    <origin xyz="-0.15 0.1 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_up_wheel_link_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin xyz="0.15 -0.1 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_down_wheel_link_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_rear_wheel"/>
    <origin xyz="-0.15 -0.1 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="pt_link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/pt_link1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="pt_dark"><color rgba="0.25 0.25 0.25 1.0" /></material>
    </visual>
    <collision>
      <geometry><mesh filename="../meshes/pt_link1.stl" scale="0.001 0.001 0.001" /></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="pt_base_link_to_pt_link1" type="revolute">
    <parent link="base_link"/>
    <child link="pt_link1"/>
    <origin xyz="-0.0035 0 0.136" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="1.0" velocity="1.0"/>
  </joint>

  <link name="pt_link2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/pt_link2.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="pt_camera"><color rgba="0.2 0.2 0.2 1.0" /></material>
    </visual>
    <collision>
      <geometry><mesh filename="../meshes/pt_link2.stl" scale="0.001 0.001 0.001" /></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="pt_link1_to_pt_link2" type="revolute">
    <parent link="pt_link1"/>
    <child link="pt_link2"/>
    <origin xyz="-0.0005 0 0.052" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1.0" velocity="1.0"/>
  </joint>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link"/>

  <joint name="camera_joint" type="fixed">
    <parent link="pt_link2"/>
    <child link="camera_link"/>
    <origin xyz="0.03 0 0.01" rpy="0 0 0"/>
  </joint>
  <link name="camera_link"/>

  <link name="left_front_wheel"/>
  <link name="left_rear_wheel"/>
  <link name="right_front_wheel"/>
  <link name="right_rear_wheel"/>

</robot>
