<?xml version="1.0" encoding="utf-8"?>
<!--
  Intel RealSense D435i — depth camera with IMU, in its aluminum peripheral
  evaluation case (same enclosure as the D435; the "i" variant only adds an
  internal accel/gyro, no visible difference). Adapted from the Apache-2.0
  realsenseai/realsense-ros (ros2-master, realsense2_description/urdf/
  _d435i.urdf.xacro + _d435.urdf.xacro + _d435i_imu_modules.urdf.xacro).
  Case dimensions/mass/frame offsets are from that same source (90 x 25 x 25
  mm, 72 g). The depth/infra/color/imu frames below are realsense-ros' own
  "use_nominal_extrinsics" values — the real device streams calibrated
  extrinsics dynamically over TF from the driver, but a static Catalog asset
  needs them baked in instead.
-->
<robot name="realsense_d435i">

  <link name="realsense_d435i_bottom_screw_frame"/>

  <joint name="realsense_d435i_link_joint" type="fixed">
    <origin xyz="0.0106 0.0175 0.0125" rpy="0 0 0"/>
    <parent link="realsense_d435i_bottom_screw_frame"/>
    <child link="realsense_d435i_link"/>
  </joint>

  <link name="realsense_d435i_link">
    <visual>
      <!-- mesh origin sits at the front glass, between the two IR axes -->
      <origin xyz="0.0043 -0.0175 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="../meshes/Realsense_D435i.dae"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 -0.0175 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02505 0.090 0.025"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.072"/>
      <inertia
        ixx="5.24e-05" ixy="0.0" ixz="0.0"
        iyy="7.52e-06" iyz="0.0"
        izz="5.24e-05"/>
    </inertial>
  </link>

  <!-- Depth sensor frame (REP-103) -->
  <link name="realsense_d435i_depth_frame"/>
  <joint name="realsense_d435i_depth_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="realsense_d435i_link"/>
    <child link="realsense_d435i_depth_frame"/>
  </joint>

  <link name="realsense_d435i_depth_optical_frame"/>
  <joint name="realsense_d435i_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="realsense_d435i_depth_frame"/>
    <child link="realsense_d435i_depth_optical_frame"/>
  </joint>

  <!-- Left imager (infra1) -->
  <link name="realsense_d435i_infra1_frame"/>
  <joint name="realsense_d435i_infra1_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="realsense_d435i_link"/>
    <child link="realsense_d435i_infra1_frame"/>
  </joint>

  <link name="realsense_d435i_infra1_optical_frame"/>
  <joint name="realsense_d435i_infra1_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="realsense_d435i_infra1_frame"/>
    <child link="realsense_d435i_infra1_optical_frame"/>
  </joint>

  <!-- Right imager (infra2) -->
  <link name="realsense_d435i_infra2_frame"/>
  <joint name="realsense_d435i_infra2_joint" type="fixed">
    <origin xyz="0 -0.050 0" rpy="0 0 0"/>
    <parent link="realsense_d435i_link"/>
    <child link="realsense_d435i_infra2_frame"/>
  </joint>

  <link name="realsense_d435i_infra2_optical_frame"/>
  <joint name="realsense_d435i_infra2_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="realsense_d435i_infra2_frame"/>
    <child link="realsense_d435i_infra2_optical_frame"/>
  </joint>

  <!-- Color sensor frame -->
  <link name="realsense_d435i_color_frame"/>
  <joint name="realsense_d435i_color_joint" type="fixed">
    <origin xyz="0 0.015 0" rpy="0 0 0"/>
    <parent link="realsense_d435i_link"/>
    <child link="realsense_d435i_color_frame"/>
  </joint>

  <link name="realsense_d435i_color_optical_frame"/>
  <joint name="realsense_d435i_color_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="realsense_d435i_color_frame"/>
    <child link="realsense_d435i_color_optical_frame"/>
  </joint>

  <!-- IMU: accelerometer (internal, no separate visual geometry) -->
  <link name="realsense_d435i_accel_frame"/>
  <joint name="realsense_d435i_accel_joint" type="fixed">
    <origin xyz="-0.01174 -0.00552 0.0051" rpy="0 0 0"/>
    <parent link="realsense_d435i_link"/>
    <child link="realsense_d435i_accel_frame"/>
  </joint>

  <link name="realsense_d435i_accel_optical_frame"/>
  <joint name="realsense_d435i_accel_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="realsense_d435i_accel_frame"/>
    <child link="realsense_d435i_accel_optical_frame"/>
  </joint>

  <!-- IMU: gyroscope -->
  <link name="realsense_d435i_gyro_frame"/>
  <joint name="realsense_d435i_gyro_joint" type="fixed">
    <origin xyz="-0.01174 -0.00552 0.0051" rpy="0 0 0"/>
    <parent link="realsense_d435i_link"/>
    <child link="realsense_d435i_gyro_frame"/>
  </joint>

  <link name="realsense_d435i_gyro_optical_frame"/>
  <joint name="realsense_d435i_gyro_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="realsense_d435i_gyro_frame"/>
    <child link="realsense_d435i_gyro_optical_frame"/>
  </joint>

</robot>
