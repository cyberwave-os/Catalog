{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/lib/utils/motion": ["./vendor/cyberwave-frontend/motion.ts"],
      "@/lib/utils/rotation": ["./vendor/cyberwave-frontend/rotation.ts"],
      "@/lib/utils/joint-name-mapping": ["./vendor/cyberwave-frontend/joint-name-mapping.ts"],
      "@/lib/types/motion": ["./vendor/cyberwave-frontend/motion-types.ts"],
      "@/lib/constants/cyberwave-constants": ["./vendor/cyberwave-frontend/cyberwave-constants.ts"]
    }
  },
  "include": ["src", "vendor"]
}
